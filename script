    };

    const blogData = {
        pt: [
            { title: "Estudo de Caso: Redesenhando para a Empatia", excerpt: "Como uma única entrevista com usuário remodelou nossa filosofia de design.", date: "18 DE ABRIL, 2024", team: "EQUIPE AXON", tag: "NOVO" },
            { title: "Insights: O Poder do Feedback do Usuário", excerpt: "Aproveitando a voz da comunidade para excelência em design iterativo.", date: "18 DE ABRIL, 2024", team: "PESQUISA", tag: null },
            { title: "Vozes do Design: Dra. Elara Vance em UI Ética", excerpt: "Sessão de Perguntas e Respostas sobre proteção à privacidade e bem-estar digital.", date: "18 DE ABRIL, 2024", team: "COMUNIDADE", tag: "ENTREVISTA" }
        ],
        en: [
            { title: "Case Study: Redesigning for Empathy - A Personal Story", excerpt: "How a single user interview reshaped our design philosophy and approach.", date: "APRIL 18, 2024", team: "AXON TEAM", tag: "NEW" },
            { title: "Insights: The Power of User Feedback", excerpt: "Leveraging community voices for iterative design excellence in real-time.", date: "APRIL 18, 2024", team: "RESEARCH TEAM", tag: null },
            { title: "Voices of Design: Dr. Elara Vance on Ethical UI", excerpt: "Community Expert Q&A on protecting user privacy and digital well-being.", date: "APRIL 18, 2024", team: "COMMUNITY", tag: "INTERVIEW" }
        ]
    };

    let currentLang = 'pt';
    const langToggleBtn = document.getElementById('lang-toggle');

    const renderBlogPosts = () => {
        const gridContainer = document.getElementById('dynamic-posts-grid');
        if (!gridContainer) return;

        const postsHTML = blogData[currentLang].map((post) => {
            const tagHTML = post.tag ? `<span class="post-tag">${post.tag}</span>` : '';
            return `
                <div class="post-card">
                    <div class="card-icon"><i class="fa-regular fa-bookmark"></i></div>
                    <h3>${post.title}</h3>
                    <p>${post.excerpt}</p>
                    <div class="post-meta">
                        <span>${post.date} | ${post.team}</span>
                        ${tagHTML}
                    </div>
                </div>
            `;
        }).join('');
        gridContainer.innerHTML = postsHTML;
    };

    const updateLanguage = (lang) => {
        document.documentElement.lang = lang === 'pt' ? 'pt-BR' : 'en';
        const elements = document.querySelectorAll('[data-i18n]');
        
        elements.forEach(el => {
            const key = el.getAttribute('data-i18n');
            if (translations[lang][key]) {
                el.innerHTML = translations[lang][key];
            }
        });

        langToggleBtn.innerText = lang === 'pt' ? 'EN' : 'PT';
        renderBlogPosts();
    };

    langToggleBtn.addEventListener('click', () => {
        currentLang = currentLang === 'pt' ? 'en' : 'pt';
        updateLanguage(currentLang);
    });

    renderBlogPosts();

    // 2. Comportamento do Header Flutuante ao Rolar (Mobile-First Scroll Reveal)
    const header = document.getElementById('site-header');
    window.addEventListener('scroll', () => {
        if (window.scrollY > 120) {
            header.classList.add('visible-nav');
        } else {
            header.classList.remove('visible-nav');
        }
    });

    // 3. Observer para Construção Progressiva e Perspectiva Ampliada no Scroll
    const revealElements = document.querySelectorAll('.scroll-reveal');
    const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
                observer.unobserve(entry.target);
            }
        });
    }, {
        threshold: 0.15
    });

    revealElements.forEach(el => revealObserver.observe(el));

    // 4. Efeito Spotlight de Luz com Toque / Mouse nos Cards
    document.addEventListener('mousemove', (e) => {
        const cards = document.querySelectorAll('.post-card, .feature-card, .featured-post');
        cards.forEach(card => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            card.style.setProperty('--mouse-x', `${x}px`);
            card.style.setProperty('--mouse-y', `${y}px`);
        });
    });

    // 5. Suporte a Tema Escuro / Claro
    const themeToggleBtn = document.getElementById('theme-toggle');
    const icon = themeToggleBtn.querySelector('i');
    
    themeToggleBtn.addEventListener('click', () => {
        document.body.classList.toggle('light-theme');
        if (document.body.classList.contains('light-theme')) {
            icon.classList.replace('fa-moon', 'fa-sun');
        } else {
            icon.classList.replace('fa-sun', 'fa-moon');
        }
    });

    // 6. Feedback Interativo de CTA
    document.body.addEventListener('click', (e) => {
        if(e.target.classList.contains('cta-btn')) {
            e.preventDefault();
            alert(currentLang === 'pt' ? 'Bem-vindo ao ecossistema Axon AI! Redirecionando...' : 'Welcome to the Axon AI ecosystem! Redirecting...');
        }
    });
});
